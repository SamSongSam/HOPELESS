float vaultR   = chf("%C%vaultBunkerRadius");
float maxD     = chf("%C%vaultDepth");
int   clawCnt  = chi("%C%anchorClawCount");
vector col     = chv("%C%colVault");

// 1. Vault Bunker Hub
int segs = 16;
for (int s = 0; s < segs; s++) {
    float a1 = float(s) / float(segs) * M_PI * 2.0;
    float a2 = float(s + 1) / float(segs) * M_PI * 2.0;
    
    vector top1 = set(cos(a1) * vaultR, maxD + 50.0, sin(a1) * vaultR);
    vector top2 = set(cos(a2) * vaultR, maxD + 50.0, sin(a2) * vaultR);
    vector bot1 = set(cos(a1) * (vaultR * 1.3), maxD, sin(a1) * (vaultR * 1.3));
    vector bot2 = set(cos(a2) * (vaultR * 1.3), maxD, sin(a2) * (vaultR * 1.3));
    
    int p1 = addpoint(0, top1);
    int p2 = addpoint(0, top2);
    int p3 = addpoint(0, bot2);
    int p4 = addpoint(0, bot1);
    
    setpointattrib(0, "Cd", p1, col, "set");
    setpointattrib(0, "Cd", p2, col, "set");
    setpointattrib(0, "Cd", p3, col * 0.8, "set");
    setpointattrib(0, "Cd", p4, col * 0.8, "set");
    
    setpointattrib(0, "part_id", p1, 9, "set");
    setpointattrib(0, "part_id", p2, 9, "set");
    setpointattrib(0, "part_id", p3, 9, "set");
    setpointattrib(0, "part_id", p4, 9, "set");
    
    int prim = addprim(0, "poly");
    addvertex(0, prim, p1);
    addvertex(0, prim, p2);
    addvertex(0, prim, p3);
    addvertex(0, prim, p4);
}

// 2. Bedrock Hydraulic Anchor Claws
for (int c = 0; c < clawCnt; c++) {
    float a = float(c) / float(clawCnt) * M_PI * 2.0;
    vector root = set(cos(a) * (vaultR * 1.2), maxD + 20.0, sin(a) * (vaultR * 1.2));
    vector mid  = set(cos(a) * (vaultR * 2.5), maxD - 30.0, sin(a) * (vaultR * 2.5));
    vector tip  = set(cos(a) * (vaultR * 3.8), maxD - 120.0, sin(a) * (vaultR * 3.8));
    
    int pt1 = addpoint(0, root);
    int pt2 = addpoint(0, mid);
    int pt3 = addpoint(0, tip);
    
    setpointattrib(0, "Cd", pt1, col * 0.6, "set");
    setpointattrib(0, "Cd", pt2, col * 0.6, "set");
    setpointattrib(0, "Cd", pt3, set(0.85, 0.25, 0.15), "set"); // Thermal claw tip
    
    setpointattrib(0, "part_id", pt1, 9, "set");
    setpointattrib(0, "part_id", pt2, 9, "set");
    setpointattrib(0, "part_id", pt3, 9, "set");
    
    int claw_prim = addprim(0, "polyline");
    addvertex(0, claw_prim, pt1);
    addvertex(0, claw_prim, pt2);
    addvertex(0, claw_prim, pt3);
}
